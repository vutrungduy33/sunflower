@import '../common.wxss';

.map-panel {
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.poi-card {
  border-radius: 22rpx;
  background: var(--sun-soft-card);
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--sun-card-border);
  box-shadow: 0 10rpx 20rpx rgba(188, 159, 87, 0.06);
}

.poi-card:last-child {
  margin-bottom: 0;
}

.poi-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.poi-card__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--sun-ink);
}

.poi-card__distance {
  font-size: 22rpx;
  color: var(--sun-olive);
}

.poi-card__meta {
  margin: 10rpx 0 16rpx;
  color: var(--sun-muted);
  font-size: 23rpx;
}
