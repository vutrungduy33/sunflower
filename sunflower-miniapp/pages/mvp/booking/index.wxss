@import '../common.wxss';

.filter-row {
  display: flex;
  gap: 16rpx;
}

.filter-field {
  flex: 1;
  background: var(--sun-soft-card);
  border-radius: 20rpx;
  padding: 16rpx;
  border: 1rpx solid var(--sun-card-border);
}

.filter-field--calendar {
  padding-bottom: 18rpx;
}

.filter-label {
  display: block;
  font-size: 22rpx;
  color: var(--sun-muted);
}

.filter-value-row {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.filter-value {
  font-size: 26rpx;
  color: var(--sun-ink);
}

.filter-separator {
  font-size: 22rpx;
  color: var(--sun-muted);
}

.filter-tip {
  margin-top: 8rpx;
  display: block;
  font-size: 20rpx;
  color: var(--sun-olive);
}

.search-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  gap: 14rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: var(--sun-field-bg);
  border: 1rpx solid var(--sun-field-border);
  border-radius: 18rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}

.room-card {
  background: var(--sun-soft-card);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 18rpx;
  border: 1rpx solid var(--sun-card-border);
  box-shadow: 0 10rpx 20rpx rgba(188, 159, 87, 0.06);
}

.room-card:last-child {
  margin-bottom: 0;
}

.room-card__image {
  width: 100%;
  height: 260rpx;
}

.room-card__body {
  padding: 20rpx;
}

.room-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--sun-ink);
}

.room-card__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--sun-muted);
}

.room-card__tags {
  margin-top: 12rpx;
}

.room-card__footer {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
