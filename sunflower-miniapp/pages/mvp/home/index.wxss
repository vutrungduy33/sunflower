@import '../common.wxss';

.hero-card {
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.86), transparent 30%),
    linear-gradient(135deg, #fff9de 0%, #fff2d2 40%, #f5fbe8 76%, #eef7ef 100%);
  border-radius: 32rpx;
  padding: 30rpx;
  color: var(--sun-ink);
  margin-bottom: 20rpx;
  border: 1rpx solid var(--sun-card-border);
  box-shadow: var(--sun-card-shadow-strong);
}

.hero-card__title {
  font-size: 34rpx;
  font-weight: 700;
}

.hero-card__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--sun-muted);
}

.hero-card__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.hero-card__dev-entry {
  margin-top: 18rpx;
  font-size: 22rpx;
  opacity: 0.92;
  text-decoration: underline;
}

.banner-swiper {
  height: 200rpx;
}

.banner-item {
  height: 100%;
  border-radius: 20rpx;
  background: linear-gradient(120deg, #fffdf2, #fff3dd 70%, #fff8ee);
  border: 1rpx solid rgba(233, 220, 198, 0.84);
  padding: 22rpx;
  box-sizing: border-box;
}

.banner-item__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--sun-ink);
}

.banner-item__subtitle {
  margin-top: 10rpx;
  color: var(--sun-muted);
  font-size: 24rpx;
}

.banner-item__cta {
  margin-top: 22rpx;
  color: var(--sun-gold-deep);
  font-size: 22rpx;
}

.service-card {
  background: var(--sun-mint-card);
  border-radius: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--sun-card-border);
  box-shadow: 0 10rpx 20rpx rgba(188, 159, 87, 0.05);
}

.service-card__name {
  font-size: 26rpx;
  color: var(--sun-ink);
  margin-top: 12rpx;
  font-weight: 500;
}

.service-card__desc {
  font-size: 22rpx;
  color: var(--sun-muted);
  margin-top: 8rpx;
}

.room-card {
  display: flex;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--sun-soft-card);
  border: 1rpx solid var(--sun-card-border);
  box-shadow: 0 10rpx 20rpx rgba(188, 159, 87, 0.05);
  margin-bottom: 16rpx;
}

.room-card:last-child {
  margin-bottom: 0;
}

.room-card__image {
  width: 210rpx;
  height: 170rpx;
  flex-shrink: 0;
}

.room-card__content {
  flex: 1;
  padding: 18rpx;
}

.room-card__name {
  font-size: 28rpx;
  color: var(--sun-ink);
  font-weight: 600;
}

.room-card__subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--sun-muted);
}

.room-card__footer {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.benefit-item {
  display: flex;
  align-items: center;
  color: rgba(92, 74, 46, 0.82);
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.benefit-item:last-child {
  margin-bottom: 0;
}

.benefit-item__dot {
  width: 10rpx;
  height: 10rpx;
  background: var(--sun-olive);
  border-radius: 50%;
  margin-right: 12rpx;
}

.profile-prompt-mask {
  position: fixed;
  inset: 0;
  background: rgba(92, 74, 46, 0.26);
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  box-sizing: border-box;
  z-index: 20;
}

.profile-prompt-card {
  width: 100%;
  background: var(--sun-soft-card);
  border-radius: 28rpx;
  padding: 30rpx 24rpx;
  border: 1rpx solid var(--sun-card-border);
  box-shadow: var(--sun-card-shadow-strong);
}

.profile-prompt-card__title {
  font-size: 32rpx;
  color: var(--sun-ink);
  font-weight: 700;
}

.profile-prompt-card__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--sun-muted);
  line-height: 1.6;
}

.profile-prompt-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: none;
  padding: 0;
  overflow: hidden;
  background: linear-gradient(135deg, var(--sun-gold), #ffd973 55%, var(--sun-mint-strong));
  margin: 24rpx auto 0;
}

.profile-prompt-avatar::after {
  border: none;
}

.profile-prompt-avatar__image,
.profile-prompt-avatar__placeholder {
  width: 100%;
  height: 100%;
}

.profile-prompt-avatar__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.profile-prompt-input {
  margin-top: 24rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: var(--sun-field-bg);
  border: 1rpx solid var(--sun-field-border);
  padding: 0 18rpx;
  font-size: 24rpx;
}

.profile-prompt-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
