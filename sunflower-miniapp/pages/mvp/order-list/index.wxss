@import '../common.wxss';

.order-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(255, 241, 181, 0.32), transparent 34%),
    radial-gradient(circle at bottom right, rgba(215, 241, 220, 0.24), transparent 28%),
    linear-gradient(180deg, #fffefc 0%, #fffbf3 24%, #fbfff8 62%, #f8fbf8 100%);
  padding: 20rpx;
  box-sizing: border-box;
}

.state-card {
  margin-top: 16rpx;
}

.status-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.status-list {
  display: inline-flex;
  gap: 12rpx;
}

.status-item {
  min-width: 120rpx;
  text-align: center;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--sun-muted);
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid var(--sun-card-border);
}

.status-item--active {
  color: var(--sun-olive);
  background: linear-gradient(180deg, #f2fff0, #e1f4e3);
  border-color: rgba(205, 227, 209, 0.92);
}

.order-card {
  background: var(--sun-soft-card);
  border-radius: 24rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--sun-card-border);
  box-shadow: 0 12rpx 24rpx rgba(188, 159, 87, 0.08);
}

.order-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-card__no {
  color: var(--sun-muted);
  font-size: 22rpx;
}

.order-status {
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
}

.order-status--PENDING_PAYMENT {
  color: #a56b1e;
  background: linear-gradient(180deg, #fff6d9, #ffefb8);
}

.order-status--CONFIRMED {
  color: var(--sun-olive);
  background: linear-gradient(180deg, #f2fff0, #def0e1);
}

.order-status--CHECKED_IN {
  color: #4f8b79;
  background: linear-gradient(180deg, #eefcf7, #d9f3ea);
}

.order-status--RESCHEDULED {
  color: #5b887c;
  background: linear-gradient(180deg, #f0fbf8, #deefe8);
}

.order-status--REFUNDED {
  color: #9e6b48;
  background: linear-gradient(180deg, #fff2e6, #ffe4d0);
}

.order-status--COMPLETED {
  color: rgba(92, 74, 46, 0.72);
  background: linear-gradient(180deg, #fffdf8, #f5efe5);
}

.order-status--CANCELLED {
  color: #b27463;
  background: linear-gradient(180deg, #fff0ec, #fddfd5);
}

.order-status--NO_SHOW {
  color: #b36f60;
  background: linear-gradient(180deg, #fff0eb, #f8d9cf);
}

.order-card__room {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--sun-ink);
  font-weight: 600;
}

.order-card__meta {
  margin-top: 8rpx;
  color: var(--sun-muted);
  font-size: 23rpx;
}

.order-card__footer {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-price {
  color: var(--sun-gold-deep);
  font-size: 34rpx;
  font-weight: 700;
}

.order-actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.empty {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  justify-content: center;
  align-items: center;
  color: var(--sun-muted);
  font-size: 24rpx;
}
