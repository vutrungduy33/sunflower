@import '../common.wxss';

.create-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(255, 241, 181, 0.32), transparent 34%),
    radial-gradient(circle at bottom right, rgba(215, 241, 220, 0.24), transparent 28%),
    linear-gradient(180deg, #fffefc 0%, #fffbf3 24%, #fbfff8 62%, #f8fbf8 100%);
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 64rpx;
}

.state-card {
  margin-bottom: 20rpx;
}

.create-section {
  background: var(--sun-soft-card);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--sun-card-border);
  box-shadow: 0 12rpx 24rpx rgba(188, 159, 87, 0.08);
}

.section-title {
  font-size: 30rpx;
  color: var(--sun-ink);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.room-name {
  font-size: 28rpx;
  color: var(--sun-ink);
  font-weight: 500;
  margin-bottom: 10rpx;
}

.mvp-muted {
  color: var(--sun-muted);
  font-size: 22rpx;
}

.price-line {
  margin-top: 12rpx;
  color: var(--sun-ink);
  font-size: 26rpx;
}

.price-value {
  color: var(--sun-gold-deep);
  font-size: 34rpx;
  font-weight: 700;
}

.field {
  margin-bottom: 16rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  color: rgba(92, 74, 46, 0.78);
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.field-input {
  height: 76rpx;
  border-radius: 14rpx;
  background: var(--sun-field-bg);
  border: 1rpx solid var(--sun-field-border);
  padding: 0 18rpx;
  font-size: 24rpx;
}

.field-textarea {
  width: 100%;
  min-height: 140rpx;
  border-radius: 14rpx;
  background: var(--sun-field-bg);
  border: 1rpx solid var(--sun-field-border);
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  font-size: 24rpx;
}

.field-tip {
  margin-top: 8rpx;
  color: var(--sun-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.bind-card__action {
  margin-top: 20rpx;
}

.submit-panel {
  margin-top: 32rpx;
}

.mvp-empty {
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: var(--sun-muted);
  font-size: 24rpx;
  padding: 0 40rpx;
}
