# Web node example for ECS-1. Keep the real server-side file as `.env.prod`.
DEPLOY_NODE_ROLE=web
PROD_ENV_FILE=.env.prod.web.example

# Admin web
ADMIN_WEB_APP_TITLE="Sunflower Admin Web"
ADMIN_WEB_API_BASE_URL=/api
ADMIN_WEB_API_PROXY_TARGET=http://172.25.121.83:8080
ADMIN_WEB_BIND_HOST=127.0.0.1
ADMIN_WEB_HOST_PORT=18080

# Backend upstream reached through ECS private network
BACKEND_UPSTREAM_SCHEME=http
BACKEND_UPSTREAM_HOST=172.25.121.83
BACKEND_UPSTREAM_PORT=8080

# Host nginx
HOST_NGINX_ENABLED=true
HOST_NGINX_SITE_NAME=sunflower
HOST_NGINX_ADMIN_SERVER_NAME=admin.example.com
HOST_NGINX_API_SERVER_NAME=api.example.com
HOST_NGINX_ADMIN_TLS_CERT_PATH=/etc/letsencrypt/live/admin.example.com/fullchain.pem
HOST_NGINX_ADMIN_TLS_KEY_PATH=/etc/letsencrypt/live/admin.example.com/privkey.pem
HOST_NGINX_API_TLS_CERT_PATH=/etc/letsencrypt/live/api.example.com/fullchain.pem
HOST_NGINX_API_TLS_KEY_PATH=/etc/letsencrypt/live/api.example.com/privkey.pem

# Release metadata reference. GitHub Actions writes the real values into `.release.env`
# on the server; deployment scripts ignore any stale values left in `.env.prod`.
BACKEND_IMAGE=
ADMIN_WEB_IMAGE=
SOURCE_SHA=local-dev
DEPLOY_TARGET=admin-web
RUN_SEED=false
