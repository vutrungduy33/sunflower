# Backend node example for non-production MVP validation with mock WeChat Pay.
# Keep this lane separate from `.env.prod`; it is not production readiness.
SUNFLOWER_DEPLOY_LANE=nonprod-mock-payment
DEPLOY_NODE_ROLE=backend
PROD_ENV_FILE=.env.nonprod-mock.example

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-root-password
MYSQL_DATABASE=sunflower
MYSQL_USER=sunflower
MYSQL_PASSWORD=replace-with-app-password
MYSQL_BIND_HOST=127.0.0.1
MYSQL_HOST_PORT=3306

# Backend host binding
# Keep backend bound to a private/local interface; do not expose public 8080.
BACKEND_BIND_HOST=127.0.0.1
BACKEND_HOST_PORT=8080
APP_MEDIA_AVATAR_STORAGE_PATH=/app/data/uploads/avatars

# Miniapp auth remains real even in this lane; only payment is mocked.
AUTH_TOKEN_SECRET=replace-with-nonprod-miniapp-token-secret
AUTH_TOKEN_TTL_SECONDS=7200
WECHAT_AUTH_MOCK_ENABLED=false
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
WECHAT_JSCODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
WECHAT_STABLE_ACCESS_TOKEN_URL=https://api.weixin.qq.com/cgi-bin/stable_token
WECHAT_GET_PHONE_NUMBER_URL=https://api.weixin.qq.com/wxa/business/getuserphonenumber
WECHAT_MANUAL_PHONE_BIND_ENABLED=false

# Mock payment lane. Values below are placeholders used to satisfy config
# binding; the backend must not call WeChat Pay while mock payment is enabled.
WECHAT_PAY_MOCK_ENABLED=true
WECHAT_PAY_MCH_ID=mock-mch-id
WECHAT_PAY_MERCHANT_SERIAL_NO=mock-merchant-serial
WECHAT_PAY_PRIVATE_KEY_PATH=/app/secrets/wechatpay/mock_apiclient_key.pem
WECHAT_PAY_PUBLIC_KEY_ID=mock-public-key-id
WECHAT_PAY_PUBLIC_KEY_PATH=/app/secrets/wechatpay/mock_wechatpay_public.pem
WECHAT_PAY_API_V3_KEY=00000000000000000000000000000000
WECHAT_PAY_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_PAYMENT_NOTIFY_URL=https://api.xiangrikui.cloud/api/payments/wechat/transactions/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.xiangrikui.cloud/api/payments/wechat/refunds/notify
WECHAT_PAY_CURRENCY=CNY
WECHAT_PAY_EXPIRE_MINUTES=15
WECHAT_MOCK_FIXED_OPENID=
WECHAT_MOCK_OPENID_PREFIX=mock_openid_
WECHAT_MOCK_PHONE_NUMBER_PREFIX=1880000

# Admin auth and SMS remain real enough for operator validation.
ADMIN_ACTIVATION_ALLOWLIST=13800000000:admin,13900000000:operator
ADMIN_AUTH_TOKEN_SECRET=replace-with-nonprod-admin-token-secret
ADMIN_AUTH_TOKEN_TTL_SECONDS=28800
ADMIN_SMS_PROVIDER=tencent
ADMIN_SMS_CODE_LENGTH=6
ADMIN_SMS_CODE_TTL_SECONDS=600
ADMIN_SMS_RESEND_COOLDOWN_SECONDS=60
ADMIN_SMS_HOURLY_SEND_LIMIT=5
ADMIN_SMS_DAILY_SEND_LIMIT=10
ADMIN_SMS_MAX_VERIFY_ATTEMPTS=5
ADMIN_LOGIN_FAILURE_LIMIT=5
ADMIN_LOGIN_LOCK_SECONDS=900
TENCENT_SMS_SECRET_ID=replace-with-tencent-secret-id
TENCENT_SMS_SECRET_KEY=replace-with-tencent-secret-key
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=replace-with-sms-sdk-app-id
TENCENT_SMS_SIGN_NAME=replace-with-sms-sign-name
TENCENT_SMS_TEMPLATE_ID_ACTIVATE=replace-with-activate-template-id
TENCENT_SMS_TEMPLATE_ID_RESET_PASSWORD=replace-with-reset-password-template-id

# Release metadata reference. GitHub Actions writes the real values into
# `.release.env`; deployment scripts ignore stale values left in this file.
BACKEND_IMAGE=
ADMIN_WEB_IMAGE=
SOURCE_SHA=local-dev
DEPLOY_TARGET=backend
RUN_SEED=false
